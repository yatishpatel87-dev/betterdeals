rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "yatishpatel086@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products collection
    match /products/{productId} {
      allow get: if (resource.data.status == 'published') || isAdmin();
      allow list: if (resource.data.status == 'published') || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // Videos collection
    match /videos/{videoId} {
      allow get: if (resource.data.status == 'published') || isAdmin();
      allow list: if (resource.data.status == 'published') || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(videoId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // Global site settings
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }
  }
}
